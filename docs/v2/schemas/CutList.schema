{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/CutList.schema.json",
  "title": "CutList",
  "type": "object",
  "definitions": {
    "transition": {
      "title": "Transition",
      "description": "Transition to apply at the start or end of a media section",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "Transition type", "enum": ["fade", "cut"] },
        "duration": { "type": "integer", "minimum": 0, "description": "Duration of the transition in frames, relative to the start/end of the section" }
      },
      "required": ["type","duration"]
    },
    "audioChannelKeyframe": {
      "title": "AudioChannelKeyframe",
      "description": "A keyframe defining volume level for an audio channel at a specific timeline position",
      "type": "object",
      "properties": {
        "frame": { "type": "integer", "minimum": 0, "description": "Timeline frame position for this keyframe" },
        "volume": {
          "type": "number", "minimum": 0, "maximum": 3.4028234663852886e38,
          "not": { "exclusiveMinimum": 0, "exclusiveMaximum": 1.401298464324817e-45 },
          "description": "Linear gain (0 = mute, 1 = original, >1 = amplified). Nonzero gains must fit FFmpeg's 32-bit floating-point volume processing; no loudness normalization is implied."
        }
      },
      "required": ["frame", "volume"]
    },
    "audioChannelMixing": {
      "title": "AudioChannelMixing",
      "description": "Audio mixing configuration for a specific channel",
      "type": "object",
      "properties": {
        "sourceChannel": { "type": "integer", "minimum": 0, "description": "0-indexed source audio channel number" },
        "outputChannel": { "type": "integer", "minimum": 0, "description": "0-indexed output audio channel number" },
        "keyframes": {
          "type": "array",
          "description": "Volume keyframes on the output timeline. Levels interpolate linearly between keyframes and hold the nearest level outside them; absent or empty keyframes use volume 1. Duplicate frames use the last value.",
          "items": { "$ref": "#/definitions/audioChannelKeyframe" },
          "minItems": 0
        }
      },
      "required": ["sourceChannel", "outputChannel"]
    },
    "sourceAudioPoint": {
      "title": "SourceAudioPoint",
      "type": "object",
      "description": "A gain point at an absolute output-timeline time in seconds.",
      "properties": {
        "time": { "type": "number", "minimum": 0 },
        "gain": {
          "type": "number", "minimum": 0, "maximum": 3.4028234663852886e38,
          "not": { "exclusiveMinimum": 0, "exclusiveMaximum": 1.401298464324817e-45 },
          "description": "Nonnegative linear gain; current renderer rejects values outside its safe float range rather than silently losing them."
        }
      },
      "required": ["time", "gain"],
      "additionalProperties": false
    },
    "sourceAudioRoute": {
      "title": "SourceAudioRoute",
      "description": "Route a physical channel of an input audio stream before the section's transition. Stream index counts audio streams only. Output channels are stereo. Routes sum without normalization.",
      "type": "object",
      "properties": {
        "streamIndex": { "type": "integer", "minimum": 0 },
        "sourceChannel": { "type": "integer", "minimum": 0 },
        "outputChannel": { "type": "integer", "minimum": 0, "maximum": 1 },
        "points": {
          "type": "array",
          "description": "Strictly increasing absolute output-timeline seconds; linear sample-wise gain with held endpoints. Do not supply with keyframes.",
          "items": { "$ref": "#/definitions/sourceAudioPoint" },
          "minItems": 1
        },
        "keyframes": {
          "type": "array",
          "description": "Output-timeline frames, linearly interpolated with held endpoints; empty means unity. Duplicate frames use the last value.",
          "items": { "$ref": "#/definitions/audioChannelKeyframe" }
        }
      },
      "required": ["streamIndex", "sourceChannel", "outputChannel"],
      "not": { "required": ["keyframes", "points"] },
      "additionalProperties": false
    }
  },
  "properties": {
    "version": {
      "title": "CutListVersion",
      "type": "string",
      "description": "Schema version",
      "const": "1.0.0"
    },
    "inputMedia": {
      "type": "array",
      "description": "List of input media sources",
      "items": {
        "type": "object",
        "properties": {
          "s3Location": {
            "type": "string",
            "description": "Path of the media"
          },
          "sections": {
            "type": "array",
            "description": "Start/end frames to select",
            "items": {
              "title": "MediaSection",
              "type": "object",
              "properties": {
                "startFrame": { "type": "integer", "minimum": 0 },
                "endFrame": { "type": "integer", "minimum": 1, "description": "End frame is exclusive" }
              },
              "required": ["startFrame","endFrame"],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "required": ["s3Location","sections"],
        "minItems": 1
      }
    },
    "outputTrack": {
      "type": "array",
      "description": "Ordered media sections to form the output timeline sequence",
      "items": {
        "type": "object",
        "properties": {
          "mediaIndex": { "type": "integer", "description": "Index of the media source", "minimum": 0 },
          "sectionIndex": { "type": "integer", "description": "Index of the section in the media source", "minimum": 0 },
          "sourceAudio": {
            "type": "array",
            "description": "Complete explicit physical routes for this section. Omit to retain the renderer's original input audio. Both stereo output channels must be routed.",
            "items": { "$ref": "#/definitions/sourceAudioRoute" },
            "minItems": 1
          },
          "transitionIn": {
            "type": "object",
            "description": "Transition to apply at the start of the section",
            "$ref": "#/definitions/transition"
          },
          "transitionOut": {
            "type": "object",
            "description": "Transition to apply at the end of the section",
            "$ref": "#/definitions/transition"
          }
        },
        "required": ["mediaIndex","sectionIndex"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "overlayTracks": {
      "type": "array",
      "description": "One or more overlay tracks",
      "items": {
        "type": "object",
        "properties": {
          "startFrame": { "type": "integer", "minimum": 0, "description": "Start frame on the overlay track" },
          "mediaIndex": { "type": "integer", "description": "Index of the media source", "minimum": 0 },
          "sectionIndex": { "type": "integer", "description": "Index of the section in the media source", "minimum": 0 },
          "x": { "type": "number", "description": "X position of the overlay" },
          "y": { "type": "number", "description": "Y position of the overlay" },
          "type": { "type": "string", "description": "Overlay type", "enum": ["alpha", "colorkey"] }
        },
        "required": ["startFrame","mediaIndex","sectionIndex","type"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "audioMixing": {
      "type": "array",
      "description": "Audio channel routes applied to the assembled output timeline. Routes to the same output channel are summed; output channels without routes are silent. An absent or empty array preserves the original audio.",
      "items": { "$ref": "#/definitions/audioChannelMixing" },
      "minItems": 0
    }
  },
  "required": ["inputMedia","outputTrack","version"],
  "additionalProperties": false
}
